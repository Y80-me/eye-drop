import json
import os

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SOURCE_IMAGE_NAME = "f society wallpaper for pc_upscayl_8x_high-fidelity-4x.png"
OUTPUT_IMAGE_NAME = "bundle.png"

source_img = os.path.join(BASE_DIR, SOURCE_IMAGE_NAME)
output_img = os.path.join(BASE_DIR, OUTPUT_IMAGE_NAME)

if not os.path.exists(source_img):
    raise FileNotFoundError(f"Source image not found in project directory: {source_img}")

MARKER = b"\n---EMBEDDED_PAYLOAD---\n"

cam_code = """import time
import cv2


def main():
    cap = cv2.VideoCapture(0)
    prev_time = 0.0
    shot_count = 0

    if not cap.isOpened():
        print("Camera error.")
        return

    while True:
        ret, frame = cap.read()
        if not ret:
            print("Frame read error.")
            break

        curr_time = time.time()
        fps = 1.0 / (curr_time - prev_time) if (curr_time - prev_time) > 0 else 0.0
        prev_time = curr_time

        cv2.putText(
            frame,
            f"FPS: {int(fps)} | S: Snap | Q: Quit",
            (10, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 255, 0),
            2,
        )

        cv2.imshow("Basic Camera", frame)

        key = cv2.waitKey(1) & 0xFF
        if key in (ord("q"), ord("Q")):
            break
        elif key in (ord("s"), ord("S")):
            shot_count += 1
            filename = f"capture_{shot_count}.png"
            cv2.imwrite(filename, frame)
            print("Saved:", filename)

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
"""

cmd_script = """@echo off
for /L %%i in (1,1,5) do start cmd /c "timeout /t 1 >nul & exit"
"""

payload = json.dumps(
    {
        "cmd": cmd_script,
        "cam": cam_code,
    },
    ensure_ascii=False,
).encode("utf-8")

with open(source_img, "rb") as f:
    img_data = f.read()

with open(output_img, "wb") as f:
    f.write(img_data + MARKER + payload)

print("Created bundle:", output_img)
